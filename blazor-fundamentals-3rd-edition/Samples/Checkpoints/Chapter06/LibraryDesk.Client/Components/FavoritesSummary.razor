@using LibraryDesk.Client.Services
@inject FavoritesState Favorites
@implements IDisposable

<p role="status" id="favorite-count">Favorites: @Favorites.Ids.Count</p>
<button @onclick="Favorites.Clear">Clear favorites</button>

@code {
    protected override void OnInitialized() => Favorites.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Favorites.Changed -= Refresh;
}
