{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "EnableNewCheckout": true,
    "MaxCartItems": 20,
    "AllowedRegions": [ "US" ]
  },
  "PaymentOptions": {
    "ApiEndpoint": "https://example.com/sandbox",
    "TimeoutSeconds": 30,
    "RetryCount": 3
  }
}
