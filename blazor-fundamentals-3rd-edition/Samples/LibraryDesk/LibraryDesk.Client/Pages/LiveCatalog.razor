@page "/live"
@rendermode @(new InteractiveWebAssemblyRenderMode(
    prerender: false))
@using System.Net.WebSockets
@using Microsoft.AspNetCore.Http.Connections.Client
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject NavigationManager Navigation
<h1>Live catalog notices</h1>
<label for="notice">Notice</label>
<input id="notice" @bind="text" maxlength="120" />
<button @onclick="Send" disabled="@(!IsConnected)">
    Broadcast locally
</button>
<p role="status">@status</p>
<ul>
    @foreach (var notice in notices)
    {
        <li>@notice</li>
    }
</ul>

@code {
    private HubConnection? connection;
    private readonly List<string> notices = [];
    private string text = "New catalog title";
    private string status = "Connecting...";
    private const string StartFailed =
        "Initial connection failed. Reload to retry.";

    private bool IsConnected =>
        connection?.State == HubConnectionState.Connected;

    private static bool IsConnectionFailure(Exception error) =>
        error switch
        {
            HttpRequestException or OperationCanceledException
                or IOException or TimeoutException
                or WebSocketException
                or NoTransportSupportedException => true,
            AggregateException all =>
                all.InnerExceptions.Count > 0
                && all.InnerExceptions.All(
                    inner => inner is TransportFailedException),
            _ => false
        };

    protected override async Task OnInitializedAsync()
    {
        connection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("hubs/catalog"))
            .WithAutomaticReconnect()
            .Build();
        connection.On<string>("CatalogNotice", notice =>
            InvokeAsync(() =>
            {
                if (notices.Count == 20) notices.RemoveAt(0);
                notices.Add(notice);
                StateHasChanged();
            }));
        connection.Reconnecting += _ =>
            SetStatus("Reconnecting...");
        connection.Reconnected += _ => SetStatus(
            "Connected again; missed notices are not replayed.");
        connection.Closed += _ =>
            SetStatus("Disconnected. Reload to reconnect.");
        try
        {
            await connection.StartAsync();
            status = "Connected.";
        }
        catch (InvalidOperationException) when (
            connection.State == HubConnectionState.Disconnected)
        {
            status = StartFailed;
        }
        catch (Exception ex) when (IsConnectionFailure(ex))
        {
            status = StartFailed;
        }
    }

    private Task SetStatus(string value) => InvokeAsync(() =>
    {
        status = value;
        StateHasChanged();
    });

    private async Task Send()
    {
        if (connection is null || !IsConnected) return;
        try
        {
            await connection.InvokeAsync("Announce", text);
        }
        catch (HubException)
        {
            status = "Use a message from 1 to 120 characters.";
        }
        catch (Exception ex) when (IsConnectionFailure(ex)
            || ex is InvalidOperationException)
        {
            status = "Send failed. Reconnect before retrying.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (connection is not null)
            await connection.DisposeAsync();
    }
}
