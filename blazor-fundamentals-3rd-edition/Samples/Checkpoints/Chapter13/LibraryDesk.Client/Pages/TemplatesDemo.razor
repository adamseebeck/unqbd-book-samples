@page "/templates"
@rendermode InteractiveServer
@using LibraryDesk.Client.Components
@using LibraryDesk.Client.Models
<h1>Templated catalog</h1>
<ErrorBoundary>
    <ChildContent>
        <BookList TItem="BookItem" Items="books">
            <ItemTemplate Context="book">
                <SelectBook Id="book.Id" Title="@book.Title" Selected="Choose" />
            </ItemTemplate>
        </BookList>
    </ChildContent>
    <ErrorContent><p role="alert">The catalog component failed. Reload to retry.</p></ErrorContent>
</ErrorBoundary>
<p role="status">Selected identifier: @selected</p>
@code {
    private readonly BookItem[] books = [new(1, "C# Field Notes", 24m), new(2, "Blazor Field Notes", 28m)];
    private int selected;
    private void Choose(int id) => selected = id;
}
