@WarehouseApi_HostAddress = http://localhost:5080

# WH-12 fails ValidWarehouseCode: 400 with a validation problem
POST {{WarehouseApi_HostAddress}}/api/stock-adjustments
Content-Type: application/json
Idempotency-Key: 2c3d4e5f-6a7b-4c8d-9e0f-1a2b3c4d5e6f

{
    "sku": "SKU-001",
    "warehouseCode": "WH-12",
    "quantityChange": 5,
    "reasonCode": "RECEIPT"
}

###

# Valid: 200 OK with the new stock level; the log shows the timing line with this correlation ID
POST {{WarehouseApi_HostAddress}}/api/stock-adjustments
Content-Type: application/json
Idempotency-Key: 8f7e6d5c-4b3a-4f2e-9d1c-0b9a8f7e6d5c
