<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:core="clr-namespace:MauiInventory.Core;assembly=Inventory.Core"
 x:Class="MauiInventory.App.ProductsPage"
 Title="Products" SafeAreaEdges="All">
 <CollectionView x:Name="ProductList" Margin="20" SelectionMode="Single" SelectionChanged="OnSelected">
  <CollectionView.Header>
   <Label Text="Your inventory" FontSize="24" Margin="0,0,0,12" SemanticProperties.HeadingLevel="Level1"/>
  </CollectionView.Header>
  <CollectionView.ItemTemplate>
   <DataTemplate x:DataType="core:Product">
    <Border Padding="12" Margin="0,4" Stroke="#A0A0A0">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Label Text="{Binding Name}" LineBreakMode="TailTruncation"/>
      <Label Grid.Column="1" Text="{Binding Quantity,StringFormat='Stock {0}'}"/>
     </Grid>
    </Border>
   </DataTemplate>
  </CollectionView.ItemTemplate>
 </CollectionView>
</ContentPage>
