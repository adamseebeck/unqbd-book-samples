@page "/"
@using System.Text.Json
@inject IJSRuntime JS

<h1>Offline reading list (version 2)</h1>
<label for="reading-title">Book title</label>
<input id="reading-title" @bind="title" maxlength="120" />
<button @onclick="Save" disabled="@(!ready || saving)">
    Save on this device
</button>
<p role="status">@status</p>
<ul>
    @foreach (var item in titles)
    {
        <li>@item</li>
    }
</ul>

@code {
    private const string Key = "librarydesk.reading.v1";
    private string title = "";
    private string[] titles = [];
    private string status = "No saved list loaded.";
    private bool ready;
    private bool saving;

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var json = await JS.InvokeAsync<string?>(
                "localStorage.getItem", Key);
            titles = JsonSerializer.Deserialize<string[]>(
                json ?? "[]") ?? [];
            status = $"Loaded {titles.Length} local titles.";
        }
        catch (Exception ex)
            when (ex is JSException or JsonException)
        {
            status = "Local storage is unavailable or invalid. "
                + "Save to replace this device's list.";
        }
        ready = true;
        StateHasChanged();
    }

    private async Task Save()
    {
        if (!ready || saving) return;
        if (string.IsNullOrWhiteSpace(title))
        {
            status = "Enter a title.";
            return;
        }
        if (titles.Length >= 50)
        {
            status = "This local list is limited to 50 titles.";
            return;
        }
        var updated = titles.Append(title.Trim()).ToArray();
        saving = true;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", Key,
                JsonSerializer.Serialize(updated));
            titles = updated;
            title = "";
            status = "Saved on this device.";
        }
        catch (JSException)
        {
            status = "Storage failed. The list was not saved.";
        }
        finally
        {
            saving = false;
        }
    }
}
