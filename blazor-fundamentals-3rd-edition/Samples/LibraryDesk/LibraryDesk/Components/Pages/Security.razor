@page "/security"
@using Microsoft.AspNetCore.Components.Authorization
@inject IWebHostEnvironment Environment

<h1>Server authorization laboratory</h1>
<AuthorizeView>
    <Authorized>
        <p>Signed in as @(context.User.Identity?.Name).</p>
    </Authorized>
    <NotAuthorized>
        <p>Not signed in.</p>
    </NotAuthorized>
</AuthorizeView>
<AuthorizeView Policy="Staff">
    <Authorized>
        <p>The Staff policy allows this identity.</p>
    </Authorized>
    <NotAuthorized>
        <p>Staff access is unavailable for this identity.</p>
    </NotAuthorized>
</AuthorizeView>
<p>
    <a href="/staff">Staff page</a>
    <a href="/api/staff/count">Protected API</a>
</p>
@if (Environment.IsDevelopment())
{
    <p>Test sign-in for local Development runs only.</p>
    <form method="post" action="/lab/signin/reader">
        <AntiforgeryToken />
        <button>Use local reader identity</button>
    </form>
    <form method="post" action="/lab/signin/librarian">
        <AntiforgeryToken />
        <button>Use local librarian identity</button>
    </form>
    <form method="post" action="/lab/signout">
        <AntiforgeryToken />
        <button>Sign out locally</button>
    </form>
}
