@page
@model AdventureWorks.IdentitySample.Pages.Account.LoginModel
<h1>Local training login</h1>
<form method="post">
    <div asp-validation-summary="All"></div>
    <label asp-for="Input.Email"></label><input asp-for="Input.Email" />
    <label asp-for="Input.Password"></label><input asp-for="Input.Password" />
    <button type="submit">Sign in</button>
</form>
