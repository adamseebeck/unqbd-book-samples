@page "/modes"
@using LibraryDesk.Client.Components
<h1>Render mode boundaries</h1>
<p id="static-marker">
    This page has no render mode, so it uses static SSR.
    Page renderer: @RendererInfo.Name.
</p>
<h2>Server island</h2>
<ModeCounter Step="2" @rendermode="InteractiveServer" />
<h2>WebAssembly island</h2>
<ModeCounter Step="3" @rendermode="InteractiveWebAssembly" />
<h2>Auto island</h2>
<ModeCounter Step="4" @rendermode="InteractiveAuto" />
