{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Database": {
        "CommandTimeoutSeconds": 30,
        "EnableSensitiveDataLogging": false
    },
    "WarehouseFeatures": {
        "EnableRealTimeInventory": false,
        "DefaultPageSize": 20,
        "MaxPageSize": 100,
        "AllowedOrigins": [
            "https://warehouse.example.com"
        ]
    },
    "InventoryThresholds": {
        "LowStockThreshold": 20,
        "CriticalStockThreshold": 5
    }
}
