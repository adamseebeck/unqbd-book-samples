<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:core="clr-namespace:MauiInventory.Core;assembly=Inventory.Core" xmlns:local="clr-namespace:MauiInventory.App"
 x:Class="MauiInventory.App.InventoryDashboardPage" x:DataType="core:PagedProductsViewModel" Title="Stock dashboard">
 <ContentPage.Resources>
  <local:StockLevelToColorConverter x:Key="StockColor"/><local:StockTextConverter x:Key="StockText"/>
  <DataTemplate x:Key="StandardRow" x:DataType="core:Product">
   <Grid Padding="8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
    <Label Text="{Binding Name}"/><Label Grid.Column="1" Text="{Binding Quantity}"/>
    <Label Grid.Column="2" Text="{Binding Quantity,Converter={StaticResource StockText}}"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="LowStockRow" x:DataType="core:Product">
   <Border Padding="8" Stroke="Orange" StrokeThickness="2">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
     <Label Text="{Binding Name}" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding Quantity}"/>
     <HorizontalStackLayout Grid.Column="2" Spacing="8"><BoxView WidthRequest="12" HeightRequest="12" Color="{Binding Quantity,Converter={StaticResource StockColor}}" AutomationProperties.IsInAccessibleTree="False"/>
      <Label Text="{Binding Quantity,Converter={StaticResource StockText}}"/></HorizontalStackLayout>
    </Grid>
   </Border>
  </DataTemplate>
  <local:StockTemplateSelector x:Key="Rows" Standard="{StaticResource StandardRow}" LowStock="{StaticResource LowStockRow}"/>
 </ContentPage.Resources>
 <Grid Padding="16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
  <Label Text="Stock levels" FontSize="24" SemanticProperties.HeadingLevel="Level1"/>
  <CollectionView Grid.Row="1" ItemsSource="{Binding Products}" ItemTemplate="{StaticResource Rows}" RemainingItemsThreshold="8" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
   <CollectionView.EmptyView><Label Text="No inventory items"/></CollectionView.EmptyView>
  </CollectionView>
  <Label Grid.Row="2" Text="{Binding ErrorMessage}"/>
  <VerticalStackLayout Grid.Row="3" Spacing="8">
   <Button Text="Fail next page" Clicked="FailNext"/>
   <Button Text="Retry or load next page" Clicked="LoadNext"/>
  </VerticalStackLayout>
 </Grid>
</ContentPage>
