@page "/security"
@using Microsoft.AspNetCore.Components.Authorization
@inject IWebHostEnvironment Environment
<h1>Server authorization laboratory</h1>
<AuthorizeView Policy="Staff">
    <Authorized><p>Signed in as librarian. The server policy permits staff reads.</p></Authorized>
    <NotAuthorized><p>Staff access is unavailable for this identity.</p></NotAuthorized>
</AuthorizeView>
<p><a href="/staff">Staff page</a> <a href="/api/staff/count">Protected API</a></p>
@if (Environment.IsDevelopment())
{
    <p>Local passwordless fixture only. Never expose Development to untrusted clients.</p>
    <form method="post" action="/lab/signin/reader">
        <AntiforgeryToken /><button>Use local reader identity</button>
    </form>
    <form method="post" action="/lab/signin/librarian">
        <AntiforgeryToken /><button>Use local librarian identity</button>
    </form>
    <form method="post" action="/lab/signout">
        <AntiforgeryToken /><button>Sign out locally</button>
    </form>
}
