{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.SemanticKernel": "Warning",
      "Microsoft.Agents.AI": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Offline",
    "Endpoint": "",
    "ChatDeployment": "",
    "EmbeddingDeployment": "",
    "UseEntraId": false,
    "TimeoutSeconds": 120,
    "StrictStructuredOutput": true,
    "Pricing": {
      "InputPerMillion": 1.00,
      "CachedInputPerMillion": 0.25,
      "OutputPerMillion": 4.00,
      "EmbeddingPerMillion": 0.02
    }
  },
  "KernelResilience": {
    "MaxRetryAttempts": 2,
    "BaseDelayMilliseconds": 1000,
    "MaxDelayMilliseconds": 10000,
    "AttemptTimeoutSeconds": 45,
    "TotalTimeoutSeconds": 120,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerSamplingSeconds": 60,
    "CircuitBreakerBreakSeconds": 60
  },
  "Database": {
    "Provider": "Sqlite",
    "InitializeOnStartup": true
  },
  "ConnectionStrings": {
    "SupportDb": "Data Source=contoso-support.db",
    "CopilotDb": "Data Source=contoso-copilot.db"
  },
  "Fallback": {
    "FallbackMessage": "Thank you for your patience. A support engineer is reviewing your ticket and will reply shortly.",
    "EnableCache": true,
    "CacheDuration": "00:05:00"
  },
  "VectorStore": {
    "Provider": "InMemory",
    "Dimensions": null,
    "TopK": 5,
    "MinScore": 0.2
  },
  "Search": {
    "Endpoint": "",
    "IndexName": "contoso-knowledge",
    "UseEntraId": false
  },
  "Rag": {
    "MaxOutputTokens": 1500,
    "ProductAreasByEngineer": {
      "engineer-ana": [ "Authentication", "API" ],
      "engineer-ben": [ "Payments" ]
    }
  },
  "Evaluation": {
    "StoragePath": "evaluation-results",
    "RequesterId": "evaluation-runner",
    "JudgeDeployment": "",
    "JudgeMaxOutputTokens": 16000
  },
  "Workflow": {
    "MaxStepRetries": 2,
    "RetryAfterSeconds": 60
  },
  "Telemetry": {
    "ServiceName": "contoso-support-copilot",
    "ServiceVersion": "1.0.0",
    "Exporter": "None",
    "EnableSensitiveData": false,
    "UseFileExporter": true,
    "File": {
      "FilePath": "telemetry.jsonl",
      "MaxFileSizeBytes": 10485760,
      "MaxRotatedFiles": 5
    }
  },
  "Health": {
    "AIProbeIntervalSeconds": 300,
    "AIProbeRetrySeconds": 30,
    "AIProbeTimeoutSeconds": 10
  },
  "Budget": {
    "DailyLimitUsd": 100,
    "AlertThresholdPercent": 80,
    "MaxTokensPerConversation": 50000
  },
  "EmbeddingCache": {
    "MaxEntries": 10000
  },
  "KeyVault": {
    "Url": ""
  }
}
