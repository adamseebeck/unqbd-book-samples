@page "/diagnostics"
@rendermode InteractiveServer
@inject ILogger<Diagnostics> Logger
<PageTitle>Catalog diagnostics</PageTitle>
<h1>Catalog diagnostics</h1>
<button @onclick="Record">Record catalog read</button>
<p role="status">Reads recorded: @reads</p>
@code {
    private int reads;
    private void Record()
    {
        reads++;
        Logger.LogInformation(
            "CatalogRead {BookCount} {ReadNumber}", 3, reads);
    }
}
