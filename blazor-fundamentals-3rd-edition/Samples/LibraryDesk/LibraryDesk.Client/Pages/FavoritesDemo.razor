@page "/favorites"
@rendermode InteractiveServer
@using LibraryDesk.Client.Components
@using LibraryDesk.Client.Services
@inject FavoritesState Favorites
<h1>Favorite books</h1>
<button @onclick="() => Favorites.Add(1)">Favorite C#</button>
<button @onclick="() => Favorites.Add(2)">Favorite Blazor</button>
<FavoritesSummary />
<CascadingValue Name="Theme" Value='@("dark")' IsFixed="true">
    <ThemeLabel />
</CascadingValue>
