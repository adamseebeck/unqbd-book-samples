@page "/live"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.Http.Connections.Client
@implements IAsyncDisposable
@inject NavigationManager Navigation
<h1>Live catalog notices</h1>
<label for="notice">Notice</label><input id="notice" @bind="text" maxlength="120" />
<button @onclick="Send" disabled="@(connection?.State != HubConnectionState.Connected)">Broadcast locally</button>
<p role="status">@status</p>
<ul>@foreach (var notice in notices) { <li>@notice</li> }</ul>
@code {
    private HubConnection? connection;
    private readonly List<string> notices = [];
    private string text = "New catalog title";
    private string status = "Connecting...";
    private static bool IsConnectionFailure(Exception error) =>
        error is HttpRequestException or OperationCanceledException or IOException or TimeoutException or System.Net.WebSockets.WebSocketException or NoTransportSupportedException
        || error is AggregateException aggregate && aggregate.InnerExceptions.Count > 0
            && aggregate.InnerExceptions.All(inner => inner is TransportFailedException);
    protected override async Task OnInitializedAsync()
    {
        connection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("hubs/catalog"))
            .WithAutomaticReconnect().Build();
        connection.On<string>("CatalogNotice", notice => InvokeAsync(() =>
        {
            if (notices.Count == 20) notices.RemoveAt(0);
            notices.Add(notice);
            StateHasChanged();
        }));
        connection.Reconnecting += _ => SetStatus("Reconnecting...");
        connection.Reconnected += _ => SetStatus("Connected again; missed notices are not replayed.");
        connection.Closed += _ => SetStatus("Disconnected. Reload to reconnect.");
        try { await connection.StartAsync(); status = "Connected."; }
        catch (Exception ex) when (IsConnectionFailure(ex)
            || (ex is InvalidOperationException && connection.State == HubConnectionState.Disconnected))
        { status = "Initial connection failed. Reload to retry."; }
    }
    private Task SetStatus(string value) => InvokeAsync(() => { status = value; StateHasChanged(); });
    private async Task Send()
    {
        if (connection?.State != HubConnectionState.Connected) return;
        try { await connection.InvokeAsync("Announce", text); }
        catch (HubException) { status = "Use a message from 1 to 120 characters."; }
        catch (Exception ex) when (IsConnectionFailure(ex) || ex is InvalidOperationException)
        { status = "Send failed. Reconnect before retrying."; }
    }
    public async ValueTask DisposeAsync()
    {
        if (connection is not null) await connection.DisposeAsync();
    }
}
