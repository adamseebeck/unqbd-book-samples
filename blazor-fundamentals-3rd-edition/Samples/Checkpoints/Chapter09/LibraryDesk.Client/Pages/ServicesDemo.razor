@page "/services"
@rendermode InteractiveServer
@using LibraryDesk.Client.Models
@using LibraryDesk.Client.Services
@inject ICatalogQuery Catalog
<h1>Catalog service</h1>
<p>Registered query returns @books.Length books.</p>
<ul>@foreach (var book in books) { <li @key="book.Id">@book.Title</li> }</ul>

@code {
    private BookItem[] books = [];
    protected override async Task OnInitializedAsync() => books = await Catalog.GetAsync();
}
