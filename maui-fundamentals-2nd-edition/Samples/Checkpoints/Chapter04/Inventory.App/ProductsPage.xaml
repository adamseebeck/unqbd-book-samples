<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:core="clr-namespace:MauiInventory.Core;assembly=Inventory.Core"
 x:Class="MauiInventory.App.ProductsPage"
 Title="Products" SafeAreaEdges="All">
 <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
  <Label Text="Your inventory" FontSize="24" SemanticProperties.HeadingLevel="Level1"/>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
   <Entry x:Name="SearchBox" Placeholder="Search names or SKUs"/>
   <Button Grid.Column="1" Text="Search" Clicked="OnSearch"/>
  </Grid>
  <CollectionView x:Name="ProductList" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnSelected">
   <CollectionView.ItemTemplate>
    <DataTemplate x:DataType="core:Product">
     <Border Padding="12" Margin="0,4" Stroke="#A0A0A0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
       <Label Text="{Binding Name}" LineBreakMode="TailTruncation"/>
       <Label Grid.Column="1" Text="{Binding Quantity,StringFormat='Stock {0}'}"/>
      </Grid>
     </Border>
    </DataTemplate>
   </CollectionView.ItemTemplate>
  </CollectionView>
 </Grid>
</ContentPage>
